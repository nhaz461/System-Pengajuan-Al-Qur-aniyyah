# ============================================================
# Environment Variables - Backend Production (Supabase Cloud)
# ============================================================

# Database Connection (Supabase PostgreSQL)
# Gunakan Session/Transaction Pooler port 6543 untuk serverless / cloud:
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL untuk migrasi schema (Prisma db push):
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Port Server
PORT=5000
NODE_ENV=production

# JWT Authentication Secret (Ganti dengan string acak panjang untuk produksi)
JWT_SECRET=AlQuraniyyah_JWT_Secret_2026_YayasanPendidikanIslam
JWT_EXPIRES_IN=8h

# CORS Whitelist (URL Frontend Vercel Anda)
CORS_ORIGIN=https://keuangan-alquraniyyah.vercel.app

# Upload Configuration
UPLOAD_DIR=../uploads
MAX_FILE_SIZE=15728640
