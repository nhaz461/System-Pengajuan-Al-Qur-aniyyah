{
  "name": "alquraniyyah-backend",
  "version": "1.0.0",
  "description": "Backend - Sistem Administrasi Keuangan Yayasan Al-Qur'aniyyah",
  "main": "index.js",
  "scripts": {
    "dev": "node node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only src/index.ts",
    "build": "node node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:seed": "node -e \"require('ts-node').register({ transpileOnly: true }); require('./src/seed.ts')\"",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "db:clean-transactions": "node scripts/clean_transactions.js",
    "db:reset": "node node_modules/prisma/build/index.js migrate reset --force"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/exceljs": "^0.5.3",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.5",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
